# Copy this file to .env and edit. Every line is optional.

# ---- External frontend integration ----
# HOST=0.0.0.0 to accept calls from other machines (default 127.0.0.1 = this PC only)
# CORS_ORIGINS=http://localhost:5173,https://app.example.com   (default * = any origin)
# API_KEY=some-long-secret   (if set, /api/* requires header  X-API-Key: <key>)

# ---- Online mode (Groq, free tier) ----
# Get a free key at https://console.groq.com  →  API Keys
GROQ_API_KEY=
# whisper-large-v3 (most accurate, best for Hindi/Hinglish) | whisper-large-v3-turbo (a bit faster)
GROQ_MODEL=whisper-large-v3
# Audio is cut into pieces of about this many seconds (at quiet points) and sent in parallel
GROQ_CHUNK_SECONDS=120
GROQ_PARALLEL=3

# ---- Local mode (faster-whisper on your GPU/CPU) ----
LOCAL_ENABLED=true
# large-v3-turbo | large-v3 | hinglish | small   (or a path to any CTranslate2 Whisper folder)
LOCAL_MODEL=large-v3-turbo
# auto | cuda | cpu
LOCAL_DEVICE=auto
# auto picks int8_float16 on GPU, int8 on CPU. Options: int8_float16, int8, float16, float32
LOCAL_COMPUTE_TYPE=auto
# 5 = more accurate on noisy meetings, 1 = fastest
LOCAL_BEAM_SIZE=5
# Batched decoding is the big speed win on GPU. Lower to 4 if a 4 GB card runs out of memory
# with large-v3 (the app also falls back automatically). 0 = sequential.
LOCAL_BATCH_SIZE=8
# Load the default model when the server starts
LOCAL_PRELOAD=true
# Where models are stored
# MODELS_DIR=./models

# ---- Audio clean-up for noisy recordings (toggle in the UI) ----
ENHANCE_AUDIO=true
# ENHANCE_FILTER=highpass=f=80,lowpass=f=7800,afftdn=nf=-25,dynaudnorm=f=150:g=15:p=0.9

# ---- Server ----
HOST=127.0.0.1
PORT=8000
